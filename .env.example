# ---------------------------------------------------------------------------
# Plataforma Gaming — variables de entorno (plantilla)
# Copia este archivo a `.env` y rellena los valores.
# Nunca comitees `.env`.
# ---------------------------------------------------------------------------

# --- Base de datos (PostgreSQL) ---
# Cadena de conexión. Ajusta usuario, contraseña y nombre de base.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gaming?schema=public"

# --- Autenticación (Better Auth) ---
# URL base del frontend (usada para construir redirects).
BETTER_AUTH_URL="http://localhost:3000"
# Secreto para firmar las sesiones. Genera uno con: npx @better-auth/cli secret
AUTH_SECRET=""
# Orígenes adicionales de confianza (separados por coma) si despliegas la app.
# BETTER_AUTH_TRUSTED_ORIGINS=""

# OAuth — Google (opcional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OAuth — GitHub (opcional)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
